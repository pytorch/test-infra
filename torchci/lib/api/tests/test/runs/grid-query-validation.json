        },
        "sql": "\nWITH (\n    SELECT groupUniqArray(run.github_workflow_job_id)\n    FROM ci.runs AS run\n    WHERE run.tests_id = {test_id: UInt64}\n        AND run.environments_id IN (\n        SELECT environment.id\n        FROM ci.environments AS environment FINAL\n        WHERE environment.python_version IN {filter_python_version: Array(String)}\n    )\n        AND run.env_vars_id IN (\n        SELECT id FROM ci.env_vars AS env_var_set FINAL\n        WHERE (mapContains(env_var_set.env_vars, {env_var_name_0: String})\n        AND env_var_set.env_vars[{env_var_name_0: String}] IN {env_var_values_0: Array(String)})\n    )\n        AND run.started_at >= fromUnixTimestamp64Milli({since: Int64}, 'UTC')\n) AS grid_job_ids,\njobs AS (\n    SELECT id, run_id, html_url, name, head_branch\n    FROM default.workflow_job FINAL\n    WHERE id IN (SELECT arrayJoin(grid_job_ids))\n    ORDER BY _inserted_at DESC, run_id DESC, dynamoKey DESC\n    LIMIT 1 BY id\n), workflows AS (\n    SELECT id, path, head_sha, event\n    FROM default.workflow_run FINAL\n    WHERE id IN (\n        SELECT run_id FROM default.workflow_job\n        WHERE id IN (SELECT arrayJoin(grid_job_ids))\n    )\n    ORDER BY _inserted_at DESC, run_attempt DESC, dynamoKey DESC\n    LIMIT 1 BY id\n)\nSELECT\n    workflow.head_sha AS commit_sha,\n    nullIf(workflow.path, '') AS workflow_path,\n    toString(run.environments_id) AS environments_id_string,\n    toString(run.env_vars_id) AS env_vars_id_string,\n    toString(run.github_workflow_job_id) AS job_id_string,\n    any(job.html_url) AS job_url,\n    any(job.name) AS job_name,\n    min(run.started_at) AS started_at,\n    argMax(run.outcome, (run.outcome != 'skipped', run.started_at, run.ended_at, toString(run.id))) AS outcome,\n    arrayMap(attempt -> attempt.4, arraySort(groupArray((run.started_at, run.ended_at, toString(run.id), toString(run.outcome))))) AS attempt_outcomes,\n    sumIf(greatest(0, dateDiff('millisecond', run.started_at, run.ended_at)), run.outcome != 'skipped') AS duration_milliseconds,\n    sumIf(greatest(0, dateDiff('millisecond', run.started_at, run.ended_at)), run.outcome = 'passed') AS passed_duration_milliseconds\nFROM (\n    SELECT run.id, run.environments_id, run.env_vars_id, run.github_workflow_job_id,\n        run.outcome, run.started_at, run.ended_at\n    FROM ci.runs AS run FINAL\n    PREWHERE run.tests_id = {test_id: UInt64}\n        AND run.environments_id IN (\n        SELECT environment.id\n        FROM ci.environments AS environment FINAL\n        WHERE environment.python_version IN {filter_python_version: Array(String)}\n    )\n        AND run.env_vars_id IN (\n        SELECT id FROM ci.env_vars AS env_var_set FINAL\n        WHERE (mapContains(env_var_set.env_vars, {env_var_name_0: String})\n        AND env_var_set.env_vars[{env_var_name_0: String}] IN {env_var_values_0: Array(String)})\n    )\n        AND run.started_at >= fromUnixTimestamp64Milli({chains_since: Int64}, 'UTC')\n) AS run\nINNER JOIN jobs AS job ON job.id = run.github_workflow_job_id\nINNER JOIN workflows AS workflow ON workflow.id = job.run_id\nWHERE workflow.head_sha != ''\n    AND multiIf(\n        job.name LIKE '%rerun_disabled_tests%', 'other',\n        job.head_branch = 'main' AND workflow.event IN ('push', 'schedule'), 'main',\n        workflow.event = 'pull_request'\n            OR (workflow.event = 'push' AND startsWith(job.head_branch, 'ciflow/')), 'pull_request',\n        'other'\n    ) IN {ran_on: Array(String)}\n    AND nullIf(workflow.path, '') IN {workflow_path: Array(String)}\nGROUP BY commit_sha, workflow_path, run.environments_id, run.env_vars_id, run.github_workflow_job_id\nHAVING min(run.started_at) >= fromUnixTimestamp64Milli({since: Int64}, 'UTC')\nORDER BY started_at, commit_sha, workflow_path, run.environments_id, run.env_vars_id, run.github_workflow_job_id\nSETTINGS optimize_move_to_prewhere_if_final = 0\n"
      },

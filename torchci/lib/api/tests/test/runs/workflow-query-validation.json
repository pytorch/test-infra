      },
      "sql": "\nWITH jobs AS (\n    SELECT id, run_id, html_url, name\n    FROM default.workflow_job FINAL\n    WHERE id IN CAST({github_workflow_job_ids: Array(String)}, 'Array(Int64)')\n    ORDER BY _inserted_at DESC, run_id DESC, dynamoKey DESC\n    LIMIT 1 BY id\n)\nSELECT\n    toString(job.id) AS github_workflow_job_id,\n    nullIf(toString(job.run_id), '0') AS github_workflow_run_id,\n    nullIf(workflow.path, '') AS workflow_path,\n    nullIf(workflow.head_sha, '') AS commit_sha,\n    nullIf(job.html_url, '') AS github_workflow_job_url,\n    nullIf(job.name, '') AS github_workflow_job_name,\n    nullIf(workflow.event, '') AS workflow_event,\n    workflow.id != 0 AS workflow_metadata_available,\n    nullIf(toString(workflow.repository_id), '0') AS workflow_repository_id,\n    CAST(arrayZip(workflow.pull_request_numbers, workflow.pull_request_urls, arrayMap(base_repository_id -> toString(base_repository_id), workflow.pull_request_base_repository_ids)), 'Array(Tuple(number Int64, url String, base_repository_id String))') AS workflow_pull_requests\nFROM jobs AS job\nLEFT JOIN (\n    SELECT id, path, head_sha, event, repository.id AS repository_id, pull_requests.number AS pull_request_numbers, pull_requests.url AS pull_request_urls, pull_requests.base.repo.id AS pull_request_base_repository_ids\n    FROM default.workflow_run FINAL\n    WHERE id IN (\n        SELECT run_id FROM default.workflow_job\n        WHERE id IN CAST({github_workflow_job_ids: Array(String)}, 'Array(Int64)')\n    )\n    ORDER BY _inserted_at DESC, run_attempt DESC, dynamoKey DESC\n    LIMIT 1 BY id\n) AS workflow ON workflow.id = job.run_id\nSETTINGS output_format_json_named_tuples_as_objects = 1\n"
    },
